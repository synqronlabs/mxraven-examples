# Copy this file to `.env` and fill in your mxRaven credentials.
# Every example reads these variables at request time.

# SMTP submission (outbound mail)
MXRAVEN_HOST=smtp.mxraven.email
MXRAVEN_PORT=587
MXRAVEN_USERNAME=mxr_tx_replace_me
MXRAVEN_SECRET=replace_me

# Webhook endpoint signing secret (inbound mail and delivery events)
MXRAVEN_WEBHOOK_SECRET=replace_me

# Example sender: must be an authorized sending domain on the tenant
MXRAVEN_MAIL_FROM=noreply@your-domain.example

# Contact form recipient
MXRAVEN_CONTACT_TO=you@your-domain.example
