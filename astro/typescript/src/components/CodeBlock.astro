---
interface Props {
  code: string;
  label?: string;
}

const { code, label } = Astro.props;
---

<div class="code-block overflow-hidden rounded-xl border border-black/10 bg-zinc-950 dark:border-white/15">
  <div class="flex items-center justify-between gap-4 border-b border-white/10 px-4 py-2">
    <span class="truncate font-mono text-xs text-zinc-400">{label ?? "code"}</span>
    <button
      type="button"
      class="copy-button rounded-md border border-white/10 px-2 py-1 text-xs font-medium text-zinc-400 transition-colors hover:border-white/25 hover:text-zinc-100"
    >
      Copy
    </button>
  </div>
  <pre class="overflow-x-auto p-4 font-mono text-[13px] leading-6 text-zinc-100">{code}</pre>
</div>

<script>
  document.addEventListener("click", async (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const button = target.closest(".copy-button");
    if (!(button instanceof HTMLButtonElement)) return;

    const code = button.closest(".code-block")?.querySelector("pre")?.textContent ?? "";
    try {
      await navigator.clipboard.writeText(code);
      button.textContent = "Copied";
      window.setTimeout(() => {
        button.textContent = "Copy";
      }, 2000);
    } catch {
      button.textContent = "Copy";
    }
  });
</script>
