---
import CodeBlock from "./CodeBlock.astro";

interface Snippet {
  title?: string;
  label?: string;
  code: string;
}

interface Props {
  title: string;
  description: string;
  snippets: Snippet[];
}

const { title, description, snippets } = Astro.props;
---

<main class="mx-auto flex w-full max-w-3xl flex-1 flex-col gap-10 px-6 py-16">
  <header class="flex flex-col gap-3">
    <a
      href="/"
      class="inline-flex w-fit items-center gap-1.5 rounded-md border border-black/10 px-2.5 py-1.5 text-sm font-medium text-zinc-600 outline-none transition-colors hover:border-black/30 hover:text-zinc-900 focus-visible:ring-2 focus-visible:ring-black/25 dark:border-white/15 dark:text-zinc-400 dark:hover:border-white/40 dark:hover:text-zinc-100 dark:focus-visible:ring-white/30"
    >
      <svg
        aria-hidden="true"
        viewBox="0 0 16 16"
        class="size-4 shrink-0"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <path d="M10 3.5 5.5 8 10 12.5" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      All examples
    </a>
    <h1 class="text-3xl font-semibold tracking-tight">{title}</h1>
    <p class="text-zinc-600 dark:text-zinc-400">{description}</p>
  </header>

  <section class="flex flex-col gap-4">
    <h2 class="text-xs font-semibold uppercase tracking-widest text-zinc-500">Try it</h2>
    <slot />
  </section>

  {
    snippets.map((snippet) => (
      <section class="flex flex-col gap-2">
        <h2 class="text-xs font-semibold uppercase tracking-widest text-zinc-500">
          {snippet.title ?? "Code"}
        </h2>
        <CodeBlock code={snippet.code} label={snippet.label} />
      </section>
    ))
  }
</main>
